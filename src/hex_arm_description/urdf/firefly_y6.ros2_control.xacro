<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="firefly_y6_ros2_control" params="backend initial_positions state_timeout_sec:=0.100 activation_timeout_sec:=5.0 zenoh_connect:='tcp/127.0.0.1:7448' robot_prefix:='hexmeow/ubuntu/firefly_y6_meow' command_period_sec:=0.01 startup_timeout_sec:=30.0 prefix:='' hardware_name:='FireflyY6System' ros_namespace:=''">
    <ros2_control name="${hardware_name}" type="system">
      <hardware>
        <xacro:if value="${backend == 'real'}">
          <plugin>hex_arm_hardware/HexArmSystem</plugin>
          <param name="zenoh_connect">${zenoh_connect}</param>
          <param name="robot_prefix">${robot_prefix}</param>
          <param name="ros_namespace">${ros_namespace}</param>
          <param name="command_period_sec">${command_period_sec}</param>
          <param name="startup_timeout_sec">${startup_timeout_sec}</param>
          <param name="command_max_age_sec">0.05</param>
          <param name="state_timeout_sec">${state_timeout_sec}</param>
          <param name="activation_timeout_sec">${activation_timeout_sec}</param>
          <!-- Must exceed the driver's 5 s serialized six-axis transition timeout. -->
          <param name="service_timeout_sec">10.0</param>
        </xacro:if>
        <xacro:if value="${backend == 'mock'}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:if value="${backend == 'gz'}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
      </hardware>

      <joint name="${prefix}joint_1">
        <param name="device_joint_name">joint_1</param>
        <command_interface name="position"><param name="min">-2.86</param><param name="max">2.86</param></command_interface>
        <command_interface name="velocity"><param name="min">-6.0</param><param name="max">6.0</param></command_interface>
        <state_interface name="position"><param name="initial_value">${initial_positions['joint_1']}</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}joint_2">
        <param name="device_joint_name">joint_2</param>
        <command_interface name="position"><param name="min">-1.57</param><param name="max">2.09</param></command_interface>
        <command_interface name="velocity"><param name="min">-6.0</param><param name="max">6.0</param></command_interface>
        <state_interface name="position"><param name="initial_value">${initial_positions['joint_2']}</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}joint_3">
        <param name="device_joint_name">joint_3</param>
        <command_interface name="position"><param name="min">-1.57</param><param name="max">1.57</param></command_interface>
        <command_interface name="velocity"><param name="min">-6.0</param><param name="max">6.0</param></command_interface>
        <state_interface name="position"><param name="initial_value">${initial_positions['joint_3']}</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}joint_4">
        <param name="device_joint_name">joint_4</param>
        <command_interface name="position"><param name="min">-1.57</param><param name="max">1.57</param></command_interface>
        <command_interface name="velocity"><param name="min">-6.0</param><param name="max">6.0</param></command_interface>
        <state_interface name="position"><param name="initial_value">${initial_positions['joint_4']}</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}joint_5">
        <param name="device_joint_name">joint_5</param>
        <command_interface name="position"><param name="min">-1.54</param><param name="max">1.54</param></command_interface>
        <command_interface name="velocity"><param name="min">-6.0</param><param name="max">6.0</param></command_interface>
        <state_interface name="position"><param name="initial_value">${initial_positions['joint_5']}</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}joint_6">
        <param name="device_joint_name">joint_6</param>
        <command_interface name="position"><param name="min">-2.79</param><param name="max">2.79</param></command_interface>
        <command_interface name="velocity"><param name="min">-6.0</param><param name="max">6.0</param></command_interface>
        <state_interface name="position"><param name="initial_value">${initial_positions['joint_6']}</param></state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
