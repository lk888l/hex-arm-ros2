#!/usr/bin/env python3
import signal
import threading

import rclpy
from rclpy.executors import ExternalShutdownException, MultiThreadedExecutor
from rclpy.signals import SignalHandlerOptions

from hex_arm_bridge.node import HexArmBridge, _quiesce_multithreaded_executor


def main() -> None:
    # Keep the Context alive while an in-flight lifecycle callback cooperatively
    # cancels.  rclpy's default handler shuts the Context down first, which
    # makes the callback's lifecycle transition publication race teardown.
    rclpy.init(signal_handler_options=SignalHandlerOptions.NO)
    node = HexArmBridge()
    stop_requested = threading.Event()

    def request_stop(signum, frame) -> None:
        del signum, frame
        node.request_stop()
        stop_requested.set()

    previous_handlers = {
        signum: signal.getsignal(signum)
        for signum in (signal.SIGINT, signal.SIGTERM)
    }
    for signum in previous_handlers:
        signal.signal(signum, request_stop)

    # Default lifecycle work plus independent management, command and state
    # callback groups can all make progress without starving one another.
    executor = MultiThreadedExecutor(num_threads=4)
    executor.add_node(node)
    try:
        while rclpy.ok() and not stop_requested.is_set() and not node._shutdown_requested.is_set():
            executor.spin_once(timeout_sec=0.1)
            # Jazzy may immediately rebuild the wait set while a callback
            # group is still busy. Yield the GIL explicitly: otherwise this
            # loop can starve both its workers and native Zenoh callbacks.
            # A 1 ms yield fits well inside the 10 ms streaming period and
            # also makes a pending shutdown wake this loop immediately.
            stop_requested.wait(0.001)
    except (KeyboardInterrupt, ExternalShutdownException):
        node.request_stop()
        pass
    finally:
        # Stop scheduling first, cancel blocking Zenoh work, then join running
        # callbacks and cancel callbacks which are still queued in Jazzy's
        # Python worker pool.  Waiting only on rclpy's work tracker is not
        # sufficient: it does not count submitted callbacks until they start.
        node.request_stop()
        callback_errors = _quiesce_multithreaded_executor(executor)
        for error in callback_errors:
            node.get_logger().error(
                f"bridge callback failed while stopping: {error}"
            )

        # on_configure's finally block must now have run if configuration was
        # executing.  This check also documents the invariant before teardown.
        configuration_idle = node.wait_for_configuration_idle(2.0)
        if not configuration_idle:
            node.get_logger().error(
                "bridge configuration did not stop within 2 seconds; "
                "skipping concurrent node destruction"
            )
        executor.remove_node(node)
        executor.shutdown(timeout_sec=2.0)
        if configuration_idle:
            node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()
        for signum, handler in previous_handlers.items():
            signal.signal(signum, handler)


if __name__ == "__main__":
    main()
