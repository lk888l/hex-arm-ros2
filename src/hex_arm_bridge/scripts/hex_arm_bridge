#!/usr/bin/env python3
import rclpy
from rclpy.executors import MultiThreadedExecutor

from hex_arm_bridge.node import HexArmBridge


def main() -> None:
    rclpy.init()
    node = HexArmBridge()
    executor = MultiThreadedExecutor(num_threads=3)
    executor.add_node(node)
    try:
        executor.spin()
    except KeyboardInterrupt:
        pass
    finally:
        executor.remove_node(node)
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()

