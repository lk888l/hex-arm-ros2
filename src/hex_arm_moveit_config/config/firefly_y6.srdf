<?xml version="1.0" encoding="UTF-8"?>
<robot name="firefly_y6">
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link"/>

  <group name="arm">
    <chain base_link="base_link" tip_link="link_6"/>
  </group>

  <!-- Surveyed-pose planning reference only; not a calibrated home target.
       joints 2 and 3 are inset 0.01 rad from their observed boundary poses so
       numerical tolerance cannot place this state outside the allowed range. -->
  <group_state name="commissioning_start" group="arm">
    <joint name="joint_1" value="0.0"/>
    <joint name="joint_2" value="-1.56"/>
    <joint name="joint_3" value="3.13"/>
    <joint name="joint_4" value="0.0"/>
    <joint name="joint_5" value="0.0"/>
    <joint name="joint_6" value="0.0"/>
  </group_state>

  <!-- Requested ready pose. Real startup reaches it in J2 -> J4 -> J3 order. -->
  <group_state name="startup_ready" group="arm">
    <joint name="joint_1" value="0.0"/>
    <joint name="joint_2" value="-1.350"/>
    <joint name="joint_3" value="3.000"/>
    <joint name="joint_4" value="-0.300"/>
    <joint name="joint_5" value="0.0"/>
    <joint name="joint_6" value="0.0"/>
  </group_state>

  <!-- Kinematically adjacent links share joint/interface geometry. -->
  <disable_collisions link1="base_link" link2="link_1" reason="Adjacent"/>
  <disable_collisions link1="link_1" link2="link_2" reason="Adjacent"/>
  <disable_collisions link1="link_2" link2="link_3" reason="Adjacent"/>
  <disable_collisions link1="link_3" link2="link_4" reason="Adjacent"/>
  <disable_collisions link1="link_4" link2="link_5" reason="Adjacent"/>
  <disable_collisions link1="link_5" link2="link_6" reason="Adjacent"/>
</robot>
