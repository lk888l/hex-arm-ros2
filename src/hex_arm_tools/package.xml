<?xml version="1.0"?>
<package format="3">
  <name>hex_arm_tools</name>
  <version>0.1.0</version>
  <description>Standalone hand-guiding tools and generated robot_api Python messages.</description>
  <maintainer email="kisonhe@icloud.com">HEX arm maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <build_depend>protobuf</build_depend>
  <build_depend>hex_arm_controller</build_depend>
  <exec_depend>python3-protobuf</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
